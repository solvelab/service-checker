SERVICE_MONITOR_MODULES=steam,openai,claude,rockstar,oci,gcp,aws,github,bitbucket,cloudflare
SERVICE_MONITOR_LOG_LEVEL=INFO
SERVICE_MONITOR_DEFAULT_INTERVAL_SECONDS=60
SERVICE_MONITOR_DEFAULT_TIMEOUT_SECONDS=10
SERVICE_MONITOR_DEFAULT_USER_AGENT=service-checker/1.0

# steamstat.us is behind Cloudflare and blocks on TLS fingerprint. This module
# fetches through curl_cffi impersonation, so STEAM_USER_AGENT is inert here;
# STEAM_IMPERSONATE_PROFILE is what decides whether the request is accepted.
STEAM_URL=https://steamstat.us/
STEAM_INTERVAL_SECONDS=60
STEAM_TIMEOUT_SECONDS=10
STEAM_USER_AGENT=service-checker/steam
STEAM_RULE_KIND=status
STEAM_RULE_VALUE=major,minor
STEAM_SERVICE_FILTER=
STEAM_IMPERSONATE_PROFILE=chrome124
# A borda da Cloudflare recusa de vez em quando mesmo com o fingerprint certo
# (medido em ~30% no steam; 83% dessas passam na tentativa seguinte). Estas duas
# controlam a repeticao. O pior caso precisa caber no intervalo de verificacao.
STEAM_FETCH_ATTEMPTS=3
STEAM_FETCH_BACKOFF_SECONDS=1.5
STEAM_ENABLED=true

OPENAI_URL=https://status.openai.com/api/v2/summary.json
OPENAI_INTERVAL_SECONDS=60
OPENAI_TIMEOUT_SECONDS=10
OPENAI_USER_AGENT=service-checker/openai
OPENAI_RULE_KIND=status
OPENAI_RULE_VALUE=degraded_performance,partial_outage,major_outage
OPENAI_SERVICE_FILTER=
OPENAI_ENABLED=true

CLAUDE_URL=https://status.claude.com/api/v2/summary.json
CLAUDE_INTERVAL_SECONDS=60
CLAUDE_TIMEOUT_SECONDS=10
CLAUDE_USER_AGENT=service-checker/claude
CLAUDE_RULE_KIND=status
CLAUDE_RULE_VALUE=degraded_performance,partial_outage,major_outage
CLAUDE_SERVICE_FILTER=
CLAUDE_ENABLED=true

# Rockstar replaces the removed `cfx` slug (see app/modules/rockstar/README.md).
# This module ignores ROCKSTAR_RULE_KIND / ROCKSTAR_RULE_VALUE / ROCKSTAR_USER_AGENT:
# it classifies by the status text on the page and fetches through curl_cffi TLS
# impersonation, which sets its own headers.
ROCKSTAR_URL=https://support.rockstargames.com/servicestatus
ROCKSTAR_INTERVAL_SECONDS=60
ROCKSTAR_TIMEOUT_SECONDS=15
ROCKSTAR_SERVICE_FILTER=
ROCKSTAR_IMPERSONATE_PROFILE=chrome124
# A borda da Cloudflare recusa de vez em quando mesmo com o fingerprint certo
# (medido em ~30% no steam; 83% dessas passam na tentativa seguinte). Estas duas
# controlam a repeticao. O pior caso precisa caber no intervalo de verificacao.
ROCKSTAR_FETCH_ATTEMPTS=3
ROCKSTAR_FETCH_BACKOFF_SECONDS=1.5
ROCKSTAR_ENABLED=true

OCI_URL=https://ocistatus.oraclecloud.com/api/v2/incident-summary.rss
OCI_INTERVAL_SECONDS=60
OCI_TIMEOUT_SECONDS=10
OCI_USER_AGENT=service-checker/oci
OCI_RULE_KIND=status
OCI_RULE_VALUE=investigating,identified,monitoring
OCI_SERVICE_FILTER=Brazil East (Sao Paulo),Brazil Southeast (Vinhedo)
OCI_ENABLED=true

GCP_URL=https://status.cloud.google.com/incidents.json
GCP_INTERVAL_SECONDS=60
GCP_TIMEOUT_SECONDS=10
GCP_USER_AGENT=service-checker/gcp
GCP_RULE_KIND=status
GCP_RULE_VALUE=service_disruption,service_outage,service_information
GCP_SERVICE_FILTER=southamerica-east1,us-central1,us-east1
GCP_ENABLED=true

AWS_URL=https://health.aws.amazon.com/public/currentevents
AWS_INTERVAL_SECONDS=60
AWS_TIMEOUT_SECONDS=10
AWS_USER_AGENT=service-checker/aws
AWS_RULE_KIND=status
AWS_RULE_VALUE=operational_issue
AWS_SERVICE_FILTER=sa-east-1,us-east-1,us-east-2
AWS_ENABLED=true

GITHUB_URL=https://www.githubstatus.com/api/v2/summary.json
GITHUB_INTERVAL_SECONDS=60
GITHUB_TIMEOUT_SECONDS=10
GITHUB_USER_AGENT=service-checker/github
GITHUB_RULE_KIND=status
GITHUB_RULE_VALUE=degraded_performance,partial_outage,major_outage
GITHUB_SERVICE_FILTER=
GITHUB_ENABLED=true

BITBUCKET_URL=https://bitbucket.status.atlassian.com/api/v2/summary.json
BITBUCKET_INTERVAL_SECONDS=60
BITBUCKET_TIMEOUT_SECONDS=10
BITBUCKET_USER_AGENT=service-checker/bitbucket
BITBUCKET_RULE_KIND=status
BITBUCKET_RULE_VALUE=degraded_performance,partial_outage,major_outage
BITBUCKET_SERVICE_FILTER=
BITBUCKET_ENABLED=true

# Cloudflare publica 475 componentes: 128 produtos e o resto um por data center.
# SERVICE_FILTER vazio aqui NAO significa "tudo" — o modulo cai na allowlist curada
# abaixo, porque monitorar os data centers dispara dezenas de alertas por dia sem
# que nada que nos afete esteja fora do ar. Use "*" para monitorar os 475.
CLOUDFLARE_URL=https://www.cloudflarestatus.com/api/v2/summary.json
CLOUDFLARE_INTERVAL_SECONDS=60
CLOUDFLARE_TIMEOUT_SECONDS=10
CLOUDFLARE_USER_AGENT=service-checker/cloudflare
CLOUDFLARE_RULE_KIND=status
CLOUDFLARE_RULE_VALUE=degraded_performance,partial_outage,major_outage
# Nome que contem virgula precisa de aspas: 'Tunnel,"Arica, Chile - (ARI)"'.
CLOUDFLARE_SERVICE_FILTER=Tunnel,Authoritative DNS,Network,CDN/Cache,SSL Certificate Provisioning
CLOUDFLARE_ENABLED=true

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S %Z
TELEGRAM_TIMESTAMP_ZONE=UTC

WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_HEADER_NAME=Authorization

# The whole webhook URL is a credential: it carries key and token. Never commit it.
GOOGLE_CHAT_ENABLED=false
GOOGLE_CHAT_WEBHOOK_URL=
# A Chat space accepts 1 request/second, shared by every webhook in it.
GOOGLE_CHAT_MIN_INTERVAL_SECONDS=1.1
# Group an alert and its recovery into one conversation, keyed on the component.
GOOGLE_CHAT_THREAD_BY_CHECK=true

ALERTMANAGER_ENABLED=false
# Base URL only — the channel appends /api/v2/alerts.
ALERTMANAGER_URL=
ALERTMANAGER_TOKEN=
ALERTMANAGER_HEADER_NAME=Authorization
# Static labels merged into every alert, so Alertmanager can route: env=prod,cluster=main
ALERTMANAGER_EXTRA_LABELS=
# How far ahead endsAt sits on a firing alert. 0 derives it from the repeat window
# and the check interval — see app/notifications/alertmanager/README.md before changing.
ALERTMANAGER_RESOLVE_AFTER_SECONDS=0

NOTIFICATION_REPEAT_MINUTES=10
# Consecutive failed checks before the monitor reports itself as broken.
# Raise it to stay quiet about monitoring failures; minimum accepted value is 1.
NOTIFICATION_ERROR_THRESHOLD=3

# Alertas pendentes sobrevivem a um restart quando ha um caminho aqui. Vazio = so em
# memoria, que e o comportamento antigo: um incidente que atravessa o restart nunca
# recebe o all-clear, porque nenhum provedor anuncia a degradacao duas vezes.
# O caminho precisa estar num volume que sobreviva ao pod; emptyDir nao serve.
NOTIFICATION_STATE_PATH=/var/lib/service-checker/state.json
# Alerta gravado ha mais tempo que isto e descartado na subida, sem gerar all-clear
# tardio. 0 = sem limite.
NOTIFICATION_STATE_MAX_AGE_MINUTES=1440
